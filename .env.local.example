# 复制这个文件为 .env.local，然后填入你自己的 key。
# .env.local 已被 .gitignore 忽略，不会被提交。

# 必填：DeepSeek API Key，从 https://platform.deepseek.com/api_keys 获取
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 必填：访问口令。只有带着正确口令的请求才能批改，用来防止公开部署后
# 别人直接调接口烧你的额度。
#
# 必须改掉下面这个占位值——占位值等同于没配，服务端会拒绝一切批改请求。
# 建议用长随机串（比如 32 位），因为目前没有对失败次数做限制。
#
# 轮换口令：改这里（线上改 Vercel 的环境变量）然后重启/重新部署即可，不用改代码。
REVIEW_ACCESS_CODE=change-me-please

# 选填：模型名。默认 deepseek-chat
# DEEPSEEK_MODEL=deepseek-chat

# 选填：接口地址。默认 https://api.deepseek.com
# 改成别的 OpenAI 兼容服务（通义 / Kimi / 智谱 / Ollama）时用得上
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# 选填：单次批改超时毫秒数。默认 120000（2 分钟）
# REVIEW_TIMEOUT_MS=120000
