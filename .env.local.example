# 复制这个文件为 .env.local，然后填入你自己的 key。
# .env.local 已被 .gitignore 忽略，不会被提交。

# 必填：DeepSeek API Key，从 https://platform.deepseek.com/api_keys 获取
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 必填：访问口令。只有带着正确口令的请求才能批改，用来防止公开部署后
# 别人直接调接口烧你的额度。
#
# 必须改掉下面这个占位值——占位值等同于没配，服务端会拒绝一切批改请求。
# 建议用长随机串（比如 32 位）。服务端对连续输错有锁定（7 次 → 1 分钟，
# 10 次 → 5 分钟），配了 DATABASE_URL 之后那是**跨实例生效**的，但在 IP 粒度上——
# 同一个出口 IP 下的人会互相连累。真正的第一道防线仍然是口令本身的熵。
#
# 轮换口令：改这里（线上改 Vercel 的环境变量）然后重启/重新部署即可，不用改代码。
REVIEW_ACCESS_CODE=change-me-please

# 选填：模型名。默认 deepseek-chat
# DEEPSEEK_MODEL=deepseek-chat

# 选填：接口地址。默认 https://api.deepseek.com
# 改成别的 OpenAI 兼容服务（通义 / Kimi / 智谱 / Ollama）时用得上
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# 选填：单次批改的总预算毫秒数。默认 100000（100 秒）。
# 批改是流式的，所以它覆盖**整个生成阶段**（不再是"响应头到了就清零"），
# 也就是"这一次批改最多允许烧多久"。
# 默认值比路由的 maxDuration（120 秒）少 20 秒，留给解析和证据定位。
# 往上调的话记得同步调大 app/api/review/route.ts 的 maxDuration，
# 而且 maxDuration 还受部署平台的上限约束。
# REVIEW_TIMEOUT_MS=100000

# 选填：上游连续多少毫秒没有吐出任何新字节就中止，默认 30000（30 秒）。
# 用户真正会遇到的失败几乎都是这一种（连接还在，就是不吐字），所以它单独有一句
# 能说明白发生了什么的话。调小反应更快，但网络一抖就会把正常请求也掐掉。
# REVIEW_STALL_MS=30000

# 选填：设为 0 就整个退回"一次请求一次返回"——接口返回一次性 JSON 而不是 SSE。
# 客户端按响应的 content-type 自动识别，什么都不用改。
# 换到不支持流式的模型服务时用它。
# REVIEW_STREAM=0

# --- 限流状态存哪（线上必填，本地选填）---
#
# 口令锁定和每小时配额的状态存在 Neon Postgres 里，这样在 Vercel 上才是跨实例
# 生效的。**不配这一条会退化成单实例内存实现**——每个实例各记各的，并发打过来
# 分散到不同实例就各自计数，限制形同虚设。退化的同时：
#   * 页面上会出现一条黄色提示
#   * 终端里会打一条告警（进程启动后第一次请求时）
#   * GET /api/review 的 persistence 字段变成 "memory"
#
# 建库三步：
#   1. neon.tech 注册建库，控制台复制 Connection string（形如
#      postgresql://user:password@host/db?sslmode=require）
#   2. 粘到下面，然后跑一次 npm run db:init 建表（幂等，重复跑没事）
#   3. 本地跑 npm run db:smoke 验一遍真实的 SQL 行为
# 线上（Vercel）在项目设置的环境变量里再加同一条，然后重新部署。
#
# ⚠️ 别把示例里的占位串原样留下。它非空、长得也像连接串，会被朴素的存在性检查
# 放过——站点显示"持久化已启用"，实际指向一个不存在的库，然后每个请求都静默降级。
# 代码里专门判了这种占位串（见 lib/db.ts），但别去试探它。
# DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# --- 限流参数（都有合理默认值，一般不用动）---
#
# 规则本身写死在 lib/rate-limit.ts 里，**不做成环境变量**：连错 7 次锁 1 分钟、
# 连错 10 次锁 5 分钟、之后每错一次都锁 5 分钟、一把锁总时长最多 30 分钟、
# 期间输对口令立刻清零、1 小时没有新错误也自动清零。- 全部写死顺带消灭了
# "两个环境变量互相矛盾"这一整类问题（比如衰减窗口配得比锁还短，攻击者等一会儿
# 就能自己解锁）。详见 README 的「限流的真实边界」。

# 选填：每个 IP 每小时允许的批改请求数，默认 100。设为 0 表示不限，**强烈不建议**。
#
# 设成 0 等于对外花费没有上限：拿到网址和口令的人可以无限次调用你的 key，
# 账单一直涨到你发现为止，剩下的只有 128 KB 请求体上限和口令本身的熵。
# 注意口径：计数发生在**口令校验通过之后**，所以错口令不占额度（两道限制各管各的）；
# 反过来说，作文因为太短被拒（400）时这一次也已经计进去了——计的是"口令通过的请求"，
# 不是"真正调用了模型的请求"。
#
# ⚠️ npm run selftest 用裸 node，**不加载这个文件**。把它设成 0 再跑测试会全绿，
# 只有真的跑起来才发现配额是关的——这正是"测试全绿、线上配额却是关的"的成因。
# REVIEW_RATE_LIMIT_PER_HOUR=100

# 选填：口令错误时人为延迟的毫秒数，默认 400。用来拖慢串行爆破。
# 代价是正常用户打错一次也要等这么久，设为 0 可关掉。
ACCESS_CODE_FAIL_DELAY_MS=400
