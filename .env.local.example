# 复制这个文件为 .env.local，然后填入你自己的 key。
# .env.local 已被 .gitignore 忽略，不会被提交。

# 必填：DeepSeek API Key，从 https://platform.deepseek.com/api_keys 获取
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 必填：访问口令。只有带着正确口令的请求才能批改，用来防止公开部署后
# 别人直接调接口烧你的额度。
#
# 必须改掉下面这个占位值——占位值等同于没配，服务端会拒绝一切批改请求。
# 建议用长随机串（比如 32 位）。虽然服务端对连续输错有锁定，但那只是内存里的
# 减速带（无服务器环境下每个实例各记各的），真正的防线是口令本身的熵。
#
# 轮换口令：改这里（线上改 Vercel 的环境变量）然后重启/重新部署即可，不用改代码。
REVIEW_ACCESS_CODE=change-me-please

# 选填：模型名。默认 deepseek-chat
# DEEPSEEK_MODEL=deepseek-chat

# 选填：接口地址。默认 https://api.deepseek.com
# 改成别的 OpenAI 兼容服务（通义 / Kimi / 智谱 / Ollama）时用得上
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# 选填：单次批改超时毫秒数。默认 100000（100 秒）。
# 默认值比路由的 maxDuration（120 秒）少 20 秒，留给解析和证据定位。
# 往上调的话记得同步调大 app/api/review/route.ts 的 maxDuration，
# 而且 maxDuration 还受部署平台的上限约束。
# REVIEW_TIMEOUT_MS=100000

# --- 限流（都有合理默认值，一般不用动）---
#
# 先读清楚：这些限制存在**每个实例各自的内存**里。无服务器平台上实例不共享
# 内存、随时回收和扩容，所以它们只是"减速带"而不是"墙"——并发打过来会分散到
# 不同实例，各自独立计数。详见 README 的「限流的真实边界」。

# 选填：每个 IP 每小时允许的批改请求数，默认 15。设为 0 表示不限。
# REVIEW_RATE_LIMIT_PER_HOUR=15

# 选填：口令连续输错几次后锁定，默认 5
# ACCESS_CODE_MAX_ATTEMPTS=5

# 选填：锁定时长毫秒数，默认 900000（15 分钟）
# ACCESS_CODE_LOCKOUT_MS=900000

# 选填：口令错误时人为延迟的毫秒数，默认 400。用来拖慢串行爆破。
# 代价是正常用户打错一次也要等这么久，设为 0 可关掉。
# ACCESS_CODE_FAIL_DELAY_MS=400
